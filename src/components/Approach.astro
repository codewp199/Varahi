---
import { approach, approachIntro, principles } from '../config/site';
---

<section id="approach" class="section" aria-labelledby="approach-title">
  <div class="container">
    <header class="section-header">
      <p class="eyebrow">Approach</p>
      <h2 id="approach-title">{approachIntro.heading}</h2>
      <p class="section-intro">{approachIntro.intro}</p>
    </header>

    <ol class="steps">
      {
        approach.map((step, index) => (
          <li class="step">
            <span class="step-number" aria-hidden="true">
              {String(index + 1).padStart(2, '0')}
            </span>
            <h3>{step.title}</h3>
            <p>{step.detail}</p>
          </li>
        ))
      }
    </ol>

    <div class="principles">
      <h3 class="mini-heading">How we choose technology</h3>
      <ul role="list">
        {principles.map((p) => <li>{p}</li>)}
      </ul>
    </div>
  </div>
</section>
