---
import type { ConceptLayout } from '../config/site';

interface Props {
  layout: ConceptLayout;
  /** Text alternative for the sample website preview. */
  description: string;
}

const { layout, description } = Astro.props;
const preview = ({
  restaurant: {
    brand: 'Neighborhood restaurant',
    kicker: 'Neighborhood kitchen',
    headline: 'Dinner, done well.',
    lead: 'Seasonal plates. A table close to home.',
    action: 'Order online',
    section: 'Tonight’s favorites',
    items: [
      ['Roasted tomato soup', '$8'],
      ['Herb chicken plate', '$18'],
      ['Mushroom rigatoni', '$16'],
    ],
    note: 'Open today · 4–10 pm',
  },
  cafe: {
    brand: 'Local cafe',
    kicker: 'Coffee · bakery · good mornings',
    headline: 'Your daily cup, nearby.',
    lead: 'Thoughtful coffee and something warm from the oven.',
    action: 'See the menu',
    section: 'Cafe favorites',
    items: [
      ['Honey oat latte', '$5.50'],
      ['Butter croissant', '$4'],
      ['Berry breakfast bowl', '$9'],
    ],
    note: 'Open today · 7 am–4 pm',
  },
  clinic: {
    brand: 'Family clinic',
    kicker: 'Care for every stage of life',
    headline: 'Feel heard. Feel cared for.',
    lead: 'Friendly primary care for individuals and families.',
    action: 'Request an appointment',
    section: 'How we can help',
    items: [
      ['Family medicine', 'Learn more'],
      ['Preventive visits', 'Learn more'],
      ['Same-week requests', 'Contact us'],
    ],
    note: 'Mon–Fri · 8 am–5 pm',
  },
  gaming: {
    brand: 'Gaming lounge',
    kicker: 'Play together · stay awhile',
    headline: 'Your next match starts here.',
    lead: 'PC, console and tabletop sessions for every crew.',
    action: 'Reserve a station',
    section: 'Coming up this week',
    items: [
      ['Open play · PC', 'Today'],
      ['Fighting game night', 'Thu · 7 pm'],
      ['Weekend team bracket', 'Sat · 2 pm'],
    ],
    note: 'Open today · noon–midnight',
  },
} as const)[layout];
---

<div class={`phone phone-${layout}`} role="img" aria-label={description}>
  <div class="phone-screen" aria-hidden="true">
    <div class="preview-top">
      <strong class="preview-brand">{preview.brand}</strong>
      <span class="preview-menu" aria-hidden="true"><i></i><i></i></span>
    </div>
    <div class="preview-hero">
      <span class="preview-kicker">{preview.kicker}</span>
      <h3>{preview.headline}</h3>
      <p>{preview.lead}</p>
      <span class="preview-cta">{preview.action}</span>
    </div>
    <div class="preview-content">
      <h4>{preview.section}</h4>
      <ul class="preview-items">
        {preview.items.map(([name, detail]) => (
          <li><span>{name}</span><strong>{detail}</strong></li>
        ))}
      </ul>
      <p class="preview-hours"><span class="preview-dot"></span>{preview.note}</p>
    </div>
  </div>
</div>
