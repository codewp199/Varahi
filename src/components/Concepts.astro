---
import { concepts, conceptsIntro } from '../config/site';
import ConceptMockup from './ConceptMockup.astro';
---

<section id="concepts" class="section section-tint" aria-labelledby="concepts-title">
  <div class="container">
    <header class="section-header">
      <p class="eyebrow">Sample work</p>
      <h2 id="concepts-title">{conceptsIntro.heading}</h2>
      <p class="section-intro">{conceptsIntro.intro}</p>
    </header>

    <ul class="concept-grid" role="list">
      {
        concepts.map((concept) => (
          <li class="concept">
            <div class={`concept-stage stage-${concept.layout}`}>
              <ConceptMockup layout={concept.layout} description={concept.imageDescription} />
            </div>
            <div class="concept-body">
              <p class="badge">{concept.label}</p>
              <h3>{concept.businessType}</h3>
              <p>{concept.summary}</p>
              <h4 class="visually-hidden">What this concept explores</h4>
              <ul class="tag-list">
                {concept.explores.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
