---
import { navigation, site } from '../config/site';

interface Props {
  linkPrefix?: string;
}

const { linkPrefix = '' } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <p class="footer-name">{site.name}</p>
      <p>
        Website design and management for restaurants, cafes, small clinics and gaming zones. Initial focus area:{' '}
        {site.serviceArea}.
      </p>
    </div>

    <nav aria-label="Footer">
      <ul class="footer-links">
        {
          navigation.map((item) => (
            <li>
              <a href={`${linkPrefix}${item.href}`}>{item.label}</a>
            </li>
          ))
        }
        <li><a href={`${linkPrefix}#contact`}>Contact</a></li>
      </ul>
    </nav>

    <div>
      <p><a class="footer-email" href={`mailto:${site.contact.email}`}>{site.contact.email}</a></p>
      {
        site.social.length > 0 && (
          <ul class="footer-links" aria-label="Social profiles">
            {site.social.map((link) => (
              <li>
                <a href={link.href} rel="noopener">{link.label}</a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>

  <div class="container footer-base">
    <p>© {year} {site.name}.</p>
  </div>
</footer>
