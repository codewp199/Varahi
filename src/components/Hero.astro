---
import { hero, site } from '../config/site';
import ConceptMockup from './ConceptMockup.astro';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">{hero.eyebrow}</p>
      <h1 id="hero-title">{hero.headline}</h1>
      <p class="lead">{hero.lead}</p>
      <div class="actions">
        <a class="button" href={hero.primaryCta.href}>{hero.primaryCta.label}</a>
        <a class="button button-ghost" href={hero.secondaryCta.href}>{hero.secondaryCta.label}</a>
      </div>
      <p class="hero-meta">
        <span class="dot" aria-hidden="true"></span>
        Initial focus area: {site.serviceArea}
      </p>
    </div>

    <figure class="hero-visual">
      <ConceptMockup
        layout="retail"
        description="Drawn phone mockup of a fictional local shop homepage showing a featured banner, product tiles and opening hours."
      />
      <figcaption>
        <span class="badge">Illustrative concept</span>
        Fictional business — not client work.
      </figcaption>
    </figure>
  </div>
</section>
