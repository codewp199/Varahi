---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const home = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<BaseLayout title="Page not found" description="The page you were looking for could not be found." noindex>
  <Header linkPrefix={home} />
  <main id="main" tabindex="-1" class="not-found">
    <div class="container">
      <p class="eyebrow">Error 404</p>
      <h1>We couldn’t find that page.</h1>
      <p class="lead">The link may be out of date, or the address may contain a typo.</p>
      <div class="actions">
        <a class="button" href={home}>Go to the homepage</a>
        <a class="button button-ghost" href={`${home}#contact`}>Contact the team</a>
      </div>
    </div>
  </main>
  <Footer linkPrefix={home} />
</BaseLayout>
