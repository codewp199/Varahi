---
/**
 * Home page composition. To add, remove or reorder a section, edit this list
 * (and the matching navigation entry in src/config/site.ts). Section copy lives
 * in src/config/site.ts — not in the components.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import WhoWeServe from '../components/WhoWeServe.astro';
import Services from '../components/Services.astro';
import Approach from '../components/Approach.astro';
import Concepts from '../components/Concepts.astro';
import Team from '../components/Team.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout>
  <Header />
  <main id="main" tabindex="-1">
    <Hero />
    <WhoWeServe />
    <Services />
    <Approach />
    <Concepts />
    <Team />
    <Contact />
  </main>
  <Footer />
</BaseLayout>
